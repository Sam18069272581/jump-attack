{
  "expo": {
    "name": "Jump Attack",
    "slug": "jump-attack",
    "scheme": "jumpattack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sam18069272581.jumpattack",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "用于从相册导入跳跃视频。"
      }
    },
    "android": {
      "package": "com.sam18069272581.jumpattack",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于从相册导入跳跃视频。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
