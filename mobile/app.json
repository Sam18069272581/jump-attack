{
  "expo": {
    "name": "Jump Attack",
    "slug": "jump-attack",
    "scheme": "jumpattack",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sam18069272581.jumpattack",
      "infoPlist": {
        "NSCameraUsageDescription": "用于录制跳跃视频，计算滞空时间和跳高。",
        "NSMicrophoneUsageDescription": "录像时可选录制声音。",
        "NSPhotoLibraryUsageDescription": "用于从相册导入跳跃视频。"
      }
    },
    "android": {
      "package": "com.sam18069272581.jumpattack",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于从相册导入跳跃视频。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
