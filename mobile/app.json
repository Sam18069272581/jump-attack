{
  "expo": {
    "name": "Jump Attack",
    "slug": "jump-attack",
    "scheme": "jumpattack",
    "version": "1.0.0",
    "owner": "sam-lis-team",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/589a8a7c-8269-46a9-a6f1-a9fa25be2636"
    },
    "extra": {
      "eas": {
        "projectId": "589a8a7c-8269-46a9-a6f1-a9fa25be2636"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1ECE2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sam18069272581.jumpattack",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "用于从相册导入跳跃视频。"
      }
    },
    "android": {
      "package": "com.sam18069272581.jumpattack",
      "adaptiveIcon": {
        "backgroundColor": "#F1ECE2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "lang": "zh-CN",
      "favicon": "./assets/favicon.png",
      "name": "Jump Attack",
      "shortName": "Jump Attack",
      "themeColor": "#F1ECE2",
      "backgroundColor": "#F1ECE2"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1ECE2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于从相册导入跳跃视频。"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
